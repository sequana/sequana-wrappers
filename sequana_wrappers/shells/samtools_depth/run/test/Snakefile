from sequana_wrappers import get_shell

CONTAINER = "https://zenodo.org/record/18257162/files/sequana_tools_26.1.14.img"

rule all:
    input: ["test.bed"]

rule samtools_depth:
    input:
        bam="test.sorted.bam"
    output:
        "test.bed"
    log:
        "logs/samtools_depth.log"
    params:
        options=""
    threads: 2
    container:
        CONTAINER
    shell:
        get_shell("samtools_depth/run", "v1")
